# =============================================
# RecorNet Backend — Variables de Entorno
# =============================================
# Copia este archivo como .env y completa los valores.
# NUNCA subas .env al repositorio.

# --- Base de datos PostgreSQL ---
POSTGRES_DB=recornet_db
POSTGRES_USER=recornet_user
POSTGRES_PASSWORD=cambia_esta_contraseña_segura
DATABASE_URL=postgresql://recornet_user:cambia_esta_contraseña_segura@localhost:5432/recornet_db

# --- Seguridad / JWT ---
SECRET_KEY=cambia_esta_clave_secreta_muy_larga_y_aleatoria
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Cloudinary (Fase 2) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- Firebase Cloud Messaging (Fase 2) ---
FIREBASE_CREDENTIALS_FILE=./credentials/firebase.json

# --- Flask ---
FLASK_APP=src.main:create_app
FLASK_ENV=development
FLASK_DEBUG=1

# --- Servidor ---
APP_HOST=0.0.0.0
APP_PORT=3000
